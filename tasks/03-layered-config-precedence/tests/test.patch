+++ b/minecraft_mod_manager/config_cli_test.py
@@ -0,0 +1,141 @@
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+
+_REPO_ROOT = Path(__file__).resolve().parents[1]
+_DB_NAME = ".minecraft-mod-manager.db"
+
+
+def _run_main(work_dir, cli_args, home_dir=None):
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(_REPO_ROOT)
+    home = Path(home_dir) if home_dir else (work_dir / "home")
+    home.mkdir(parents=True, exist_ok=True)
+    env["HOME"] = str(home)
+
+    cmd = [sys.executable, "-m", "minecraft_mod_manager", *cli_args]
+    return subprocess.run(cmd, cwd=str(work_dir), env=env, capture_output=True, text=True, timeout=120)
+
+
+def test_main_print_config_without_config_file_prints_builtin_defaults(tmp_path):
+    proc = _run_main(tmp_path, ["list", "--print-config"])
+
+    assert proc.returncode == 0, proc.stderr
+    expected = {
+        "dir": ".",
+        "filter": {"version": None, "stability": None},
+        "mod_loader": None,
+        "minecraft_version": None,
+        "stability": None,
+    }
+    assert json.loads(proc.stdout) == expected
+    assert proc.stdout.endswith("\n")
+    # No application action may run: no database must be created
+    assert not (tmp_path / _DB_NAME).exists()
+
+
+def test_main_print_config_uses_config_file_settings(tmp_path):
+    mods_dir = tmp_path / "mods"
+    mods_dir.mkdir()
+    settings = {
+        "dir": str(mods_dir),
+        "filter": {"version": "1.16.5", "stability": "release"},
+        "mod_loader": "forge",
+        "minecraft_version": "1.16.5",
+        "stability": "release",
+    }
+    (tmp_path / "minecraft_mod_manager.json").write_text(json.dumps(settings), encoding="utf-8")
+
+    proc = _run_main(tmp_path, ["list", "--print-config"])
+
+    assert proc.returncode == 0, proc.stderr
+    assert json.loads(proc.stdout) == settings
+
+
+def test_main_print_config_cli_argument_overrides_config_file(tmp_path):
+    mods_dir = tmp_path / "mods"
+    mods_dir.mkdir()
+    settings = {
+        "dir": str(mods_dir),
+        "filter": {"version": "1.16.5", "stability": "release"},
+        "mod_loader": "forge",
+        "minecraft_version": "1.16.5",
+        "stability": "release",
+    }
+    (tmp_path / "minecraft_mod_manager.json").write_text(json.dumps(settings), encoding="utf-8")
+
+    proc = _run_main(tmp_path, ["list", "--print-config", "--mod-loader", "fabric"])
+
+    assert proc.returncode == 0, proc.stderr
+    expected = dict(settings)
+    expected["mod_loader"] = "fabric"
+    assert json.loads(proc.stdout) == expected
+
+
+def test_main_print_config_honors_explicit_config_path(tmp_path):
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    explicit_settings = {
+        "dir": ".",
+        "filter": {"version": "1.20", "stability": "release"},
+        "mod_loader": "quilt",
+        "minecraft_version": "1.20",
+        "stability": "release",
+    }
+    explicit = tmp_path / "custom-config.json"
+    explicit.write_text(json.dumps(explicit_settings), encoding="utf-8")
+    # A conflicting file in the current directory must not win over --config
+    (cwd / "minecraft_mod_manager.json").write_text(
+        json.dumps({"dir": ".", "mod_loader": "forge"}), encoding="utf-8"
+    )
+
+    proc = _run_main(cwd, ["list", "--print-config", "--config", str(explicit)])
+
+    assert proc.returncode == 0, proc.stderr
+    assert json.loads(proc.stdout) == explicit_settings
+
+
+def test_main_validation_failure_exits_nonzero_and_reports_errors_on_stderr(tmp_path):
+    (tmp_path / "minecraft_mod_manager.json").write_text(
+        json.dumps({"dir": ".", "mod_loader": "spigot", "stability": "nightly"}),
+        encoding="utf-8",
+    )
+
+    proc = _run_main(tmp_path, ["list"])
+
+    assert proc.returncode != 0
+    assert "mod_loader" in proc.stderr
+    assert "stability" in proc.stderr
+
+
+def test_main_config_file_directory_is_applied_before_action(tmp_path):
+    mods_dir = tmp_path / "mods"
+    mods_dir.mkdir()
+    (tmp_path / "minecraft_mod_manager.json").write_text(
+        json.dumps({"dir": str(mods_dir), "mod_loader": "fabric"}), encoding="utf-8"
+    )
+
+    proc = _run_main(tmp_path, ["list"])
+
+    assert proc.returncode == 0, proc.stderr
+    assert (mods_dir / _DB_NAME).exists()
+
+
+def test_main_config_file_is_discovered_in_home_directory(tmp_path):
+    work_dir = tmp_path / "work"
+    work_dir.mkdir()
+    home = tmp_path / "home"
+    home.mkdir()
+    mods_dir = tmp_path / "mods"
+    mods_dir.mkdir()
+    (home / ".minecraft_mod_manager.json").write_text(
+        json.dumps({"dir": str(mods_dir), "mod_loader": "fabric"}), encoding="utf-8"
+    )
+
+    proc = _run_main(work_dir, ["list"], home_dir=home)
+
+    assert proc.returncode == 0, proc.stderr
+    assert (mods_dir / _DB_NAME).exists()
diff --git a/minecraft_mod_manager/config_file_test.py b/minecraft_mod_manager/config_file_test.py
new file mode 100644
index 0000000..3551d67
--- /dev/null
+++ b/minecraft_mod_manager/config_file_test.py
@@ -0,0 +1,195 @@
+import json
+from pathlib import Path
+
+import pytest
+
+
+def _config_file_module():
+    """Import the new config_file module lazily so every test fails with a clear
+    message (instead of a collection error) when the feature is not implemented."""
+    try:
+        import minecraft_mod_manager.config_file as config_file
+    except ImportError as exc:  # pragma: no cover - only hit on the unmodified base
+        pytest.fail(f"minecraft_mod_manager.config_file is not implemented: {exc}")
+    return config_file
+
+
+def _write_json(path: Path, data) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data), encoding="utf-8")
+    return path
+
+
+def _isolate_home(tmp_path, monkeypatch) -> Path:
+    home = tmp_path / "home"
+    home.mkdir(parents=True, exist_ok=True)
+    monkeypatch.setenv("HOME", str(home))
+    return home
+
+
+def test_find_config_file_prefers_existing_explicit_path(tmp_path, monkeypatch):
+    config_file = _config_file_module()
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    home = _isolate_home(tmp_path, monkeypatch)
+
+    explicit = _write_json(tmp_path / "explicit.json", {"dir": "."})
+    _write_json(cwd / "minecraft_mod_manager.json", {"dir": "."})
+    _write_json(home / ".minecraft_mod_manager.json", {"dir": "."})
+    monkeypatch.chdir(cwd)
+
+    assert config_file.find_config_file(str(explicit)) == explicit
+
+
+def test_find_config_file_skips_missing_explicit_and_uses_cwd_file(tmp_path, monkeypatch):
+    config_file = _config_file_module()
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    home = _isolate_home(tmp_path, monkeypatch)
+
+    explicit = tmp_path / "missing.json"
+    cwd_file = _write_json(cwd / "minecraft_mod_manager.json", {"dir": "."})
+    _write_json(home / ".minecraft_mod_manager.json", {"dir": "."})
+    monkeypatch.chdir(cwd)
+
+    assert config_file.find_config_file(str(explicit)) == cwd_file
+
+
+def test_find_config_file_checks_cwd_before_home(tmp_path, monkeypatch):
+    config_file = _config_file_module()
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    home = _isolate_home(tmp_path, monkeypatch)
+
+    cwd_file = _write_json(cwd / "minecraft_mod_manager.json", {"dir": "."})
+    home_file = _write_json(home / ".minecraft_mod_manager.json", {"dir": "."})
+    monkeypatch.chdir(cwd)
+
+    assert config_file.find_config_file(None) == cwd_file
+    assert cwd_file != home_file
+
+
+def test_find_config_file_falls_back_to_home_when_no_cwd_file(tmp_path, monkeypatch):
+    config_file = _config_file_module()
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    home = _isolate_home(tmp_path, monkeypatch)
+
+    home_file = _write_json(home / ".minecraft_mod_manager.json", {"dir": "."})
+    monkeypatch.chdir(cwd)
+
+    assert config_file.find_config_file(None) == home_file
+
+
+def test_find_config_file_returns_none_when_nothing_exists(tmp_path, monkeypatch):
+    config_file = _config_file_module()
+    cwd = tmp_path / "cwd"
+    cwd.mkdir()
+    _isolate_home(tmp_path, monkeypatch)
+    monkeypatch.chdir(cwd)
+
+    assert config_file.find_config_file(None) is None
+    assert config_file.find_config_file(str(tmp_path / "does-not-exist.json")) is None
+
+
+def test_load_config_file_returns_parsed_json_object(tmp_path):
+    config_file = _config_file_module()
+    data = {
+        "dir": "mods",
+        "filter": {"version": "1.20", "stability": "release"},
+        "mod_loader": "forge",
+        "minecraft_version": "1.20",
+        "stability": "beta",
+    }
+    path = _write_json(tmp_path / "config.json", data)
+
+    assert config_file.load_config_file(path) == data
+
+
+def test_load_config_file_allows_partial_filter_without_adding_keys(tmp_path):
+    config_file = _config_file_module()
+    data = {"dir": "mods", "filter": {"version": "1.16.5"}}
+    path = _write_json(tmp_path / "config.json", data)
+
+    assert config_file.load_config_file(path) == data
+
+
+def test_load_config_file_raises_with_path_when_file_is_missing(tmp_path):
+    config_file = _config_file_module()
+    missing = tmp_path / "missing.json"
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(missing)
+
+    assert str(missing) in str(exc_info.value)
+
+
+def test_load_config_file_raises_with_path_on_invalid_json(tmp_path):
+    config_file = _config_file_module()
+    path = tmp_path / "broken.json"
+    path.write_text("{not valid json", encoding="utf-8")
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert str(path) in str(exc_info.value)
+
+
+def test_load_config_file_raises_when_top_level_value_is_not_an_object(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "array.json", ["dir", "mods"])
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert str(path) in str(exc_info.value)
+
+
+def test_load_config_file_rejects_unknown_top_level_key(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "config.json", {"bogus_option": True})
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert "bogus_option" in str(exc_info.value)
+
+
+def test_load_config_file_rejects_non_string_dir(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "config.json", {"dir": 42})
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert "dir" in str(exc_info.value)
+
+
+def test_load_config_file_rejects_filter_that_is_not_an_object(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "config.json", {"filter": ["version"]})
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert "filter" in str(exc_info.value)
+
+
+def test_load_config_file_rejects_non_string_filter_version(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "config.json", {"filter": {"version": 123}})
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert "version" in str(exc_info.value)
+
+
+def test_load_config_file_rejects_non_string_filter_stability(tmp_path):
+    config_file = _config_file_module()
+    path = _write_json(tmp_path / "config.json", {"filter": {"stability": False}})
+
+    with pytest.raises(config_file.ConfigFileError) as exc_info:
+        config_file.load_config_file(path)
+
+    assert "stability" in str(exc_info.value)

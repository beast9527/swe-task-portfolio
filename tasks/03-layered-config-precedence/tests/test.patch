+
+    assert config_validation.validate_config(_merged(dir=str(tmp_path))) is None
+
+
+def test_validate_config_collects_all_errors_separated_by_newlines(tmp_path):
+    config_validation = _config_validation_module()
+
+    with pytest.raises(config_validation.ConfigValidationError) as exc_info:
+        config_validation.validate_config(

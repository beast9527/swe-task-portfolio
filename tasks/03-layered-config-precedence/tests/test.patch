+    cfg.add_arg_settings(args)
+
+    assert cfg.action == Actions.configure
+    assert cfg.debug is True
+    assert cfg.verbose is True  # debug implies verbose
+    assert Path(cfg.dir) == Path(".")
+
+    # Activate the new feature as well: the optional file_settings argument must
+    # be accepted and keep the legacy args-derived attributes intact.
+    cfg.add_arg_settings(args, _merged_dict(dir=".", mod_loader="quilt", stability="beta"))
+    assert cfg.action == Actions.configure
+    assert cfg.mod_loader == "quilt"

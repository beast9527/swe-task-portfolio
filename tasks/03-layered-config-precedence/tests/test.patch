+++ b/minecraft_mod_manager/config_merge_test.py
@@ -0,0 +1,161 @@
+from argparse import Namespace
+
+import pytest
+
+
+EXPECTED_DEFAULTS = {
+    "dir": ".",
+    "filter": {"version": None, "stability": None},
+    "mod_loader": None,
+    "minecraft_version": None,
+    "stability": None,
+}
+
+
+def _config_merge_module():
+    try:
+        import minecraft_mod_manager.config_merge as config_merge
+    except ImportError as exc:  # pragma: no cover - only hit on the unmodified base
+        pytest.fail(f"minecraft_mod_manager.config_merge is not implemented: {exc}")
+    return config_merge
+
+
+def test_merge_settings_returns_exact_builtin_defaults_when_inputs_are_empty():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({}, Namespace())
+
+    assert merged == EXPECTED_DEFAULTS
+    assert set(merged) == set(EXPECTED_DEFAULTS)
+
+
+def test_merge_settings_cli_dir_overrides_file_dir_and_file_fills_rest():
+    config_merge = _config_merge_module()
+    file_settings = {
+        "dir": "/from-file",
+        "filter": {"version": "1.16", "stability": "release"},
+        "mod_loader": "forge",
+        "minecraft_version": "1.16",
+        "stability": "release",
+    }
+
+    merged = config_merge.merge_settings(file_settings, Namespace(dir="/from-cli"))
+
+    expected = dict(file_settings)
+    expected["dir"] = "/from-cli"
+    assert merged == expected
+
+
+def test_merge_settings_cli_none_values_do_not_override_file_settings():
+    config_merge = _config_merge_module()
+    file_settings = {
+        "dir": "/from-file",
+        "filter": {"version": "1.16", "stability": "release"},
+        "mod_loader": "forge",
+        "minecraft_version": "1.16",
+        "stability": "release",
+    }
+
+    merged = config_merge.merge_settings(
+        file_settings,
+        Namespace(
+            dir=None,
+            filter=None,
+            mod_loader=None,
+            minecraft_version=None,
+            stability=None,
+        ),
+    )
+
+    assert merged == file_settings
+
+
+def test_merge_settings_uses_file_dir_when_cli_attribute_is_absent():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"dir": "/from-file"}, Namespace())
+
+    expected = dict(EXPECTED_DEFAULTS)
+    expected["dir"] = "/from-file"
+    assert merged == expected
+
+
+def test_merge_settings_cli_mod_loader_overrides_file_mod_loader():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"mod_loader": "forge"}, Namespace(mod_loader="fabric"))
+
+    expected = dict(EXPECTED_DEFAULTS)
+    expected["mod_loader"] = "fabric"
+    assert merged == expected
+
+
+def test_merge_settings_uses_file_mod_loader_when_cli_is_absent():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"mod_loader": "quilt"}, Namespace())
+
+    expected = dict(EXPECTED_DEFAULTS)
+    expected["mod_loader"] = "quilt"
+    assert merged == expected
+
+
+def test_merge_settings_cli_minecraft_version_overrides_file_minecraft_version():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"minecraft_version": "1.16"}, Namespace(minecraft_version="1.20"))
+
+    assert merged["minecraft_version"] == "1.20"
+
+
+def test_merge_settings_uses_file_minecraft_version_when_cli_is_absent():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"minecraft_version": "1.16"}, Namespace(dir="/irrelevant"))
+
+    assert merged["minecraft_version"] == "1.16"
+
+
+def test_merge_settings_uses_file_stability_when_cli_has_no_stability_attribute():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"stability": "beta"}, Namespace(dir="/irrelevant"))
+
+    assert merged["stability"] == "beta"
+
+
+def test_merge_settings_cli_stability_attribute_overrides_file_stability():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"stability": "alpha"}, Namespace(stability="release"))
+
+    assert merged["stability"] == "release"
+
+
+def test_merge_settings_fills_missing_file_filter_subkeys_with_none():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"filter": {"version": "1.20"}}, Namespace())
+
+    assert merged["filter"] == {"version": "1.20", "stability": None}
+
+
+def test_merge_settings_merges_nested_filter_per_subkey():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings(
+        {"filter": {"version": "1.16", "stability": "beta"}},
+        Namespace(filter={"version": "1.20", "stability": None}),
+    )
+
+    assert merged["filter"] == {"version": "1.20", "stability": "beta"}
+
+
+def test_merge_settings_ignores_unknown_file_settings_keys():
+    config_merge = _config_merge_module()
+
+    merged = config_merge.merge_settings({"dir": "/from-file", "random_key": "value"}, Namespace())
+
+    assert set(merged) == set(EXPECTED_DEFAULTS)
+    assert "random_key" not in merged
+    assert merged["dir"] == "/from-file"
diff --git a/minecraft_mod_manager/config_settings_test.py b/minecraft_mod_manager/config_settings_test.py
new file mode 100644
index 0000000..60c6543
--- /dev/null
+++ b/minecraft_mod_manager/config_settings_test.py
@@ -0,0 +1,150 @@
+from argparse import Namespace
+from pathlib import Path
+
+from minecraft_mod_manager.config import Config
+from minecraft_mod_manager.core.entities.actions import Actions
+from minecraft_mod_manager.core.entities.mod_loaders import ModLoaders
+from minecraft_mod_manager.core.entities.version_info import Stabilities
+
+
+def _cli_args(**overrides):
+    values = {
+        "action": Actions.install,
+        "pretend": False,
+        "verbose": False,
+        "debug": False,
+        "mods": [],
+        "dir": None,
+        "minecraft_version": None,
+        "mod_loader": None,
+        "alpha": False,
+        "beta": False,
+    }
+    values.update(overrides)
+    return Namespace(**values)
+
+
+def _merged_dict(**overrides):
+    values = {
+        "dir": ".",
+        "filter": {"version": None, "stability": None},
+        "mod_loader": None,
+        "minecraft_version": None,
+        "stability": None,
+    }
+    values.update(overrides)
+    return values
+
+
+def test_add_arg_settings_applies_file_settings_when_cli_values_are_absent(tmp_path):
+    cfg = Config()
+    mods_dir = tmp_path / "mods"
+    file_settings = _merged_dict(
+        dir=str(mods_dir),
+        filter={"version": "1.20", "stability": "release"},
+        mod_loader="forge",
+        minecraft_version="1.20",
+        stability="release",
+    )
+
+    cfg.add_arg_settings(_cli_args(), file_settings)
+
+    assert Path(cfg.dir) == Path(str(mods_dir))
+    assert cfg.filter.version == "1.20"
+    assert cfg.filter.stability == "release" or cfg.filter.stability == Stabilities.release
+    assert cfg.mod_loader == "forge" or cfg.mod_loader == ModLoaders.forge
+    assert cfg.minecraft_version == "1.20"
+    assert cfg.stability == "release" or cfg.stability == Stabilities.release
+    assert cfg.action == Actions.install
+
+
+def test_add_arg_settings_cli_values_override_file_settings(tmp_path):
+    cfg = Config()
+    file_settings = _merged_dict(
+        dir=str(tmp_path / "file_dir"),
+        filter={"version": "1.16", "stability": "release"},
+        mod_loader="forge",
+        minecraft_version="1.16",
+        stability="release",
+    )
+    args = _cli_args(dir=str(tmp_path / "cli_dir"), minecraft_version="1.20", mod_loader="fabric")
+
+    cfg.add_arg_settings(args, file_settings)
+
+    assert Path(cfg.dir) == Path(tmp_path / "cli_dir")
+    assert cfg.minecraft_version == "1.20"
+    assert cfg.mod_loader == "fabric" or cfg.mod_loader == ModLoaders.fabric
+    assert cfg.stability == "release" or cfg.stability == Stabilities.release
+
+
+def test_add_arg_settings_sets_filter_object_from_merged_filter(tmp_path):
+    cfg = Config()
+    file_settings = _merged_dict(
+        dir=str(tmp_path),
+        filter={"version": "1.19.2", "stability": "beta"},
+        minecraft_version="1.19.2",
+        stability="beta",
+    )
+
+    cfg.add_arg_settings(_cli_args(), file_settings)
+
+    assert cfg.filter.version == "1.19.2"
+    assert cfg.filter.stability == "beta" or cfg.filter.stability == Stabilities.beta
+
+
+def test_add_arg_settings_keeps_legacy_attributes_when_file_settings_are_given():
+    cfg = Config()
+    args = _cli_args(action=Actions.configure, debug=True, pretend=True)
+
+    cfg.add_arg_settings(args, _merged_dict(dir="."))
+
+    assert cfg.action == Actions.configure
+    assert cfg.debug is True
+    assert cfg.pretend is True
+
+
+def test_add_arg_settings_without_file_settings_preserves_legacy_behavior():

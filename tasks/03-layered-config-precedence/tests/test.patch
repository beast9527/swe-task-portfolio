+    keys, including the nested filter dict."""
+    cfg = Config()
+    args = Namespace(
+        action=Actions.install,
+        pretend=False,
+        verbose=False,
+        debug=False,
+        mods=[],
+        dir=None,
+        filter={"version": "1.20", "stability": None},
+        mod_loader=None,
+        minecraft_version=None,
+        stability="release",
+        alpha=False,
+        beta=False,
+    )
+
+    cfg.add_arg_settings(

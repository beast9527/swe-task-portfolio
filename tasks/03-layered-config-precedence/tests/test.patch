+def test_validate_config_accepts_all_supported_stabilities(tmp_path):
+    config_validation = _config_validation_module()
+
+    for stability in ("release", "beta", "alpha"):
+        assert config_validation.validate_config(_merged(dir=str(tmp_path), stability=stability)) is None
+

+import pytest
+
+
+def _config_validation_module():
+    try:
+        import minecraft_mod_manager.config_validation as config_validation
+    except ImportError as exc:  # pragma: no cover - only hit on the unmodified base
+        pytest.fail(f"minecraft_mod_manager.config_validation is not implemented: {exc}")
+    return config_validation
+
+
+def _merged(**overrides):
+    data = {
+        "dir": ".",
+        "filter": {"version": None, "stability": None},
+        "mod_loader": None,
+        "minecraft_version": None,
+        "stability": None,
+    }
+    data.update(overrides)
+    return data
+
+
+def test_validate_config_returns_none_for_valid_existing_directory_and_enums(tmp_path):
+    config_validation = _config_validation_module()
+    merged = _merged(
+        dir=str(tmp_path),
+        filter={"version": "1.20", "stability": "beta"},
+        mod_loader="forge",
+        minecraft_version="1.20",
+        stability="beta",
+    )
+
+    assert config_validation.validate_config(merged) is None
+
+
+def test_validate_config_accepts_directory_that_can_be_created(tmp_path):
+    config_validation = _config_validation_module()
+    creatable_dir = str(tmp_path / "new_mods_folder")
+
+    assert config_validation.validate_config(_merged(dir=creatable_dir)) is None
+
+
+def test_validate_config_rejects_directory_that_is_not_a_string(tmp_path):
+    config_validation = _config_validation_module()
+
+    with pytest.raises(config_validation.ConfigValidationError) as exc_info:
+        config_validation.validate_config(_merged(dir=12345))
+
+    assert "dir" in str(exc_info.value)
+
+
+def test_validate_config_rejects_directory_whose_parent_does_not_exist(tmp_path):
+    config_validation = _config_validation_module()
+    merged = _merged(dir=str(tmp_path / "does-not-exist" / "mods"))
+
+    with pytest.raises(config_validation.ConfigValidationError) as exc_info:
+        config_validation.validate_config(merged)
+
+    assert "dir" in str(exc_info.value)
+
+
+def test_validate_config_rejects_unknown_mod_loader(tmp_path):
+    config_validation = _config_validation_module()
+
+    with pytest.raises(config_validation.ConfigValidationError) as exc_info:
+        config_validation.validate_config(_merged(dir=str(tmp_path), mod_loader="spigot"))
+
+    assert "mod_loader" in str(exc_info.value)
+
+
+def test_validate_config_accepts_all_supported_mod_loaders(tmp_path):
+    config_validation = _config_validation_module()
+
+    for mod_loader in ("forge", "fabric", "quilt"):
+        assert config_validation.validate_config(_merged(dir=str(tmp_path), mod_loader=mod_loader)) is None
+
+
+def test_validate_config_rejects_unknown_stability(tmp_path):
+    config_validation = _config_validation_module()
+
+    with pytest.raises(config_validation.ConfigValidationError) as exc_info:
+        config_validation.validate_config(_merged(dir=str(tmp_path), stability="nightly"))

+import sqlite3
+from typing import Callable, Dict, List
+
+Migration = Callable[[sqlite3.Connection], None]
+
+
+class MigrationRegistry:
+    """Manages deterministic schema migrations keyed by version number."""
+
+    def __init__(self) -> None:
+        self._migrations: Dict[int, Migration] = {}
+
+    def register(self, version: int, func: Migration) -> None:
+        """Store the migration function for the given version."""
+        if version in self._migrations:
+            raise ValueError(f"Migration for version {version} already registered")
+        self._migrations[version] = func
+
+    def versions(self) -> List[int]:
+        """Return all registered versions in ascending order."""
+        return sorted(self._migrations.keys())
+
+    def migrate(self, conn: sqlite3.Connection, from_version: int, to_version: int) -> None:
+        """Apply every registered migration with a version in (from_version, to_version]."""
+        if from_version > to_version:
+            raise ValueError("from_version must be less than or equal to to_version")
+
+        for version in range(from_version + 1, to_version + 1):
+            if version not in self._migrations:
+                raise ValueError(f"Missing migration for version {version}")
+
+        for version in range(from_version + 1, to_version + 1):
+            self._migrations[version](conn)
+
+    def validate_contiguous(self) -> bool:
+        """Return True if registered versions are contiguous and start at 1."""
+        versions = self.versions()
+        return versions == list(range(1, len(versions) + 1))

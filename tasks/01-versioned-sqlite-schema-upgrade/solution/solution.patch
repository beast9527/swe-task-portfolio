@@ -0,0 +1,29 @@
+import sqlite3
+from os import path
+from typing import Union
+
+from ...config import config
+from ...gateways.sqlite_upgrader import SqliteUpgrader
+
+
+class SchemaInfoRepo:
+    """Reads schema version and integrity information from the SQLite database."""
+
+    def __init__(self, connection: Union[sqlite3.Connection, None] = None) -> None:
+        self._owns_connection = connection is None
+        if connection is None:
+            file_path = path.join(config.dir, f".{config.app_name}.db")
+            connection = sqlite3.connect(file_path)
+        self._connection = connection
+        self._cursor = self._connection.cursor()
+        self._upgrader = SqliteUpgrader(self._connection, self._cursor)
+
+    def get_schema_version(self) -> int:
+        return self._upgrader.get_schema_version()
+
+    def verify_integrity(self) -> bool:
+        return self._upgrader.verify_integrity()
+
+    def close(self) -> None:
+        if self._owns_connection:
+            self._connection.close()

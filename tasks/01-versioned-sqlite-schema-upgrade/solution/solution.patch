+from .schema_info_repo import SchemaInfoRepo
+
+
+class SchemaInfo:
+    """Prints the schema version and integrity status of the database."""
+
+    def __init__(self, schema_info_repo: SchemaInfoRepo) -> None:
+        self._repo = schema_info_repo
+
+    def execute(self) -> None:
+        version = self._repo.get_schema_version()
+        integrity = "ok" if self._repo.verify_integrity() else "corrupt"
+        print(f"Schema version: {version}")
+        print(f"Integrity: {integrity}")

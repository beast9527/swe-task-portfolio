index 0000000..d7f5b1e
--- /dev/null
+++ b/minecraft_mod_manager/gateways/sqlite_upgrader_schema_upgrade_test.py
@@ -0,0 +1,438 @@
+import re
+import sqlite3
+from datetime import datetime, timedelta
+from pathlib import Path
+
+import pytest
+
+from minecraft_mod_manager.gateways.sqlite_upgrader import SqliteUpgrader
+
+
+BACKUP_NAME_PATTERN = re.compile(r"^backup-\d{8}-\d{6}(-\d+)?\.db$")
+
+
+def _open_upgrader(db_file: Path) -> "tuple[sqlite3.Connection, sqlite3.Cursor, SqliteUpgrader]":
+    connection = sqlite3.connect(str(db_file))
+    cursor = connection.cursor()
+    return connection, cursor, SqliteUpgrader(connection, cursor)
+
+
+def _backup_files(directory: Path) -> list:
+    return sorted(
+        path
+        for path in Path(directory).iterdir()
+        if path.is_file() and path.name.startswith("backup-") and path.name.endswith(".db")
+    )
+
+
+def _two_step_registry():
+    """Registry with versions 1 and 2 that record every applied migration."""
+    from minecraft_mod_manager.gateways.migration_registry import MigrationRegistry
+
+    registry = MigrationRegistry()
+    applied: list = []
+
+    def migrate_to_v1(conn):
+        applied.append(1)
+        conn.execute("CREATE TABLE step_1 (x INTEGER)")
+
+    def migrate_to_v2(conn):
+        applied.append(2)
+        conn.execute("CREATE TABLE step_2 (x INTEGER)")
+
+    registry.register(1, migrate_to_v1)
+    registry.register(2, migrate_to_v2)
+    return registry, applied
+
+
+def test_backup_database_creates_timestamped_file_beside_database(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER)")
+        connection.commit()
+
+        backup_path = upgrader.backup_database()
+
+        assert isinstance(backup_path, Path)
+        assert backup_path.parent == tmp_path
+        assert backup_path.exists()
+        assert re.fullmatch(r"backup-\d{8}-\d{6}\.db", backup_path.name), backup_path.name
+        assert backup_path in _backup_files(tmp_path)
+    finally:
+        connection.close()
+
+
+def test_backup_database_snapshot_contains_database_contents(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER, name TEXT)")
+        connection.execute("INSERT INTO sample VALUES (1, 'alpha')")
+        connection.execute("INSERT INTO sample VALUES (2, 'beta')")
+        connection.commit()
+
+        backup_path = upgrader.backup_database()
+
+        backup_connection = sqlite3.connect(str(backup_path))
+        try:
+            rows = backup_connection.execute("SELECT id, name FROM sample ORDER BY id").fetchall()
+        finally:
+            backup_connection.close()
+        assert rows == [(1, "alpha"), (2, "beta")]
+    finally:
+        connection.close()
+
+
+def test_backup_database_appends_unique_suffix_on_name_collision(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER)")
+        connection.execute("INSERT INTO sample VALUES (7)")
+        connection.commit()
+
+        # Occupy the would-be base names around the current local time so the
+        # implementation must pick a unique suffixed name.
+        now = datetime.now()
+        for delta in (-2, -1, 0, 1, 2):
+            stamp = (now + timedelta(seconds=delta)).strftime("%Y%m%d-%H%M%S")
+            (tmp_path / f"backup-{stamp}.db").write_bytes(b"")
+
+        backup_path = upgrader.backup_database()
+
+        assert backup_path.exists()
+        assert re.fullmatch(r"backup-\d{8}-\d{6}-\d+\.db", backup_path.name), backup_path.name
+
+        backup_connection = sqlite3.connect(str(backup_path))
+        try:
+            rows = backup_connection.execute("SELECT id FROM sample").fetchall()
+        finally:
+            backup_connection.close()
+        assert rows == [(7,)]
+    finally:
+        connection.close()
+
+
+def test_restore_database_replaces_database_with_backup_content(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER)")
+        connection.execute("INSERT INTO sample VALUES (10)")
+        connection.commit()
+
+        backup_path = upgrader.backup_database()
+
+        # Destroy the live schema after the backup was taken.
+        connection.execute("DROP TABLE sample")
+        connection.commit()
+
+        upgrader.restore_database(backup_path)
+
+        check_connection = sqlite3.connect(str(db_file))
+        try:
+            rows = check_connection.execute("SELECT id FROM sample").fetchall()
+        finally:
+            check_connection.close()
+        assert rows == [(10,)]
+        assert upgrader.verify_integrity() is True
+    finally:
+        connection.close()
+
+
+def test_restore_database_discards_changes_made_after_backup(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER)")
+        connection.execute("INSERT INTO sample VALUES (10)")
+        connection.commit()
+
+        backup_path = upgrader.backup_database()
+
+        connection.execute("INSERT INTO sample VALUES (99)")
+        connection.execute("CREATE TABLE extra (x INTEGER)")
+        connection.commit()
+
+        upgrader.restore_database(backup_path)
+
+        check_connection = sqlite3.connect(str(db_file))
+        try:
+            rows = check_connection.execute("SELECT id FROM sample ORDER BY id").fetchall()
+            table_count = check_connection.execute(
+                "SELECT count(name) FROM sqlite_master WHERE type='table' AND name='extra'"
+            ).fetchone()[0]
+        finally:
+            check_connection.close()
+        assert rows == [(10,)]
+        assert table_count == 0
+    finally:
+        connection.close()
+
+
+def test_restore_database_missing_backup_raises_file_not_found(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    missing = tmp_path / "backup-20200101-000000.db"
+    try:
+        with pytest.raises(FileNotFoundError) as excinfo:
+            upgrader.restore_database(missing)
+    finally:
+        connection.close()
+
+    assert str(excinfo.value) == f"Backup file not found: {missing}"
+
+
+def test_verify_integrity_returns_true_for_healthy_database(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE sample (id INTEGER)")
+        connection.commit()
+
+        assert upgrader.verify_integrity() is True
+    finally:
+        connection.close()
+
+
+def test_verify_integrity_returns_false_for_corrupted_database(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection = sqlite3.connect(str(db_file))
+    connection.execute("CREATE TABLE sample (a TEXT, b INTEGER)")
+    connection.executemany(
+        "INSERT INTO sample VALUES (?, ?)",
+        [("value-%d" % i, i) for i in range(50000)],
+    )
+    connection.commit()
+    connection.close()
+
+    data = bytearray(db_file.read_bytes())
+    tail = len(data) // 4
+    data[-tail:] = b"\x00" * tail
+    db_file.write_bytes(bytes(data))
+
+    corrupted_connection = sqlite3.connect(str(db_file))
+    corrupted_cursor = corrupted_connection.cursor()
+    upgrader = SqliteUpgrader(corrupted_connection, corrupted_cursor)
+    try:
+        assert upgrader.verify_integrity() is False
+    finally:
+        corrupted_connection.close()
+
+
+def test_get_schema_version_zero_when_table_missing(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        assert upgrader.get_schema_version() == 0
+    finally:
+        connection.close()
+
+
+def test_get_schema_version_zero_when_table_empty(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE schema_version (version INTEGER)")
+        connection.commit()
+
+        assert upgrader.get_schema_version() == 0
+    finally:
+        connection.close()
+
+
+def test_get_schema_version_returns_stored_integer(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        connection.execute("CREATE TABLE schema_version (version INTEGER)")
+        connection.execute("INSERT INTO schema_version (version) VALUES (5)")
+        connection.commit()
+
+        assert upgrader.get_schema_version() == 5
+    finally:
+        connection.close()
+
+
+def test_upgrade_applies_all_migrations_in_order_and_records_version(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, _ = _open_upgrader(db_file)
+    registry, applied = _two_step_registry()
+    upgrader = SqliteUpgrader(connection, cursor, migration_registry=registry)
+    try:
+        upgrader.upgrade()
+
+        assert applied == [1, 2]
+        assert upgrader.get_schema_version() == 2
+        version_row = connection.execute("SELECT version FROM schema_version").fetchone()
+        assert version_row == (2,)
+        row_count = connection.execute("SELECT count(*) FROM schema_version").fetchone()[0]
+        assert row_count == 1
+        step_tables = {
+            name
+            for (name,) in connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table' AND name IN ('step_1', 'step_2')"
+            )
+        }
+        assert step_tables == {"step_1", "step_2"}
+    finally:
+        connection.close()
+
+
+def test_upgrade_applies_only_pending_migrations_after_current_version(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, _ = _open_upgrader(db_file)
+    connection.execute("CREATE TABLE schema_version (version INTEGER)")
+    connection.execute("INSERT INTO schema_version (version) VALUES (1)")
+    connection.execute("CREATE TABLE step_1 (x INTEGER)")
+    connection.commit()
+
+    registry, applied = _two_step_registry()
+    upgrader = SqliteUpgrader(connection, cursor, migration_registry=registry)
+    try:
+        upgrader.upgrade()
+
+        assert applied == [2]
+        assert upgrader.get_schema_version() == 2
+        step_2_count = connection.execute(
+            "SELECT count(name) FROM sqlite_master WHERE type='table' AND name='step_2'"
+        ).fetchone()[0]
+        assert step_2_count == 1
+    finally:
+        connection.close()
+
+
+def test_upgrade_creates_backup_before_applying_migrations(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, _ = _open_upgrader(db_file)
+    registry, _ = _two_step_registry()
+    upgrader = SqliteUpgrader(connection, cursor, migration_registry=registry)
+    try:
+        upgrader.upgrade()
+
+        backups = _backup_files(tmp_path)
+        assert len(backups) == 1
+    finally:
+        connection.close()
+
+
+def test_upgrade_skips_work_when_already_at_latest_version(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, _ = _open_upgrader(db_file)
+    registry, applied = _two_step_registry()
+    upgrader = SqliteUpgrader(connection, cursor, migration_registry=registry)
+    try:
+        upgrader.upgrade()
+        assert len(_backup_files(tmp_path)) == 1
+
+        applied.clear()
+        backups_before = _backup_files(tmp_path)
+        upgrader.upgrade()
+        backups_after = _backup_files(tmp_path)
+
+        assert backups_before == backups_after
+        assert applied == []
+        assert upgrader.get_schema_version() == 2
+    finally:
+        connection.close()
+
+
+def test_upgrade_failure_restores_database_and_adds_message(tmp_path):
+    from minecraft_mod_manager.gateways.migration_registry import MigrationRegistry
+
+    db_file = tmp_path / "data.db"
+    connection, cursor, _ = _open_upgrader(db_file)
+    registry = MigrationRegistry()
+
+    def migrate_to_v1(conn):
+        conn.execute("CREATE TABLE step_1 (x INTEGER)")
+
+    def failing_v2(conn):
+        raise RuntimeError("boom during migration")
+
+    registry.register(1, migrate_to_v1)
+    registry.register(2, failing_v2)
+    upgrader = SqliteUpgrader(connection, cursor, migration_registry=registry)
+    try:
+        with pytest.raises(RuntimeError) as excinfo:
+            upgrader.upgrade()
+    finally:
+        connection.close()
+
+    assert "Migration failed, database restored to previous state" in str(excinfo.value)
+    assert "boom during migration" in str(excinfo.value)
+
+    # The database file must be back to its pre-upgrade (empty) state.
+    check_connection = sqlite3.connect(str(db_file))
+    try:
+        tables = [
+            name
+            for (name,) in check_connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        ]
+    finally:
+        check_connection.close()
+    assert tables == []
+
+    assert len(_backup_files(tmp_path)) == 1
+
+
+def test_upgrade_failed_migration_restores_backup_on_default_registry(tmp_path, monkeypatch):
+    from minecraft_mod_manager.gateways.migration_registry import MigrationRegistry
+
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    connection.execute("CREATE TABLE keep_me (x INTEGER)")
+    connection.execute("INSERT INTO keep_me VALUES (1)")
+    connection.commit()
+
+    real_migrate = MigrationRegistry.migrate
+
+    def exploding_migrate(self, conn, from_version, to_version):
+        if from_version < to_version:
+            conn.execute("CREATE TABLE partial_step (x INTEGER)")
+            raise RuntimeError("synthetic migration failure")
+        return real_migrate(self, conn, from_version, to_version)
+
+    monkeypatch.setattr(MigrationRegistry, "migrate", exploding_migrate)
+    try:
+        with pytest.raises(RuntimeError) as excinfo:
+            upgrader.upgrade()
+    finally:
+        connection.close()
+
+    assert "Migration failed, database restored to previous state" in str(excinfo.value)
+
+    # The failed upgrade must leave the pre-upgrade content intact and remove the
+    # partial work written by the failing migration step.
+    check_connection = sqlite3.connect(str(db_file))
+    try:
+        tables = {
+            name
+            for (name,) in check_connection.execute(
+                "SELECT name FROM sqlite_master WHERE type='table'"
+            )
+        }
+        rows = check_connection.execute("SELECT x FROM keep_me").fetchall()
+    finally:
+        check_connection.close()
+    assert "keep_me" in tables
+    assert "partial_step" not in tables
+    assert rows == [(1,)]
+
+
+def test_upgrade_on_fresh_database_creates_schema_version_table(tmp_path):
+    db_file = tmp_path / "data.db"
+    connection, cursor, upgrader = _open_upgrader(db_file)
+    try:
+        upgrader.upgrade()
+
+        row = connection.execute("SELECT version FROM schema_version").fetchone()
+        assert row is not None
+        stored_version = int(row[0])
+        assert stored_version >= 1
+        assert upgrader.get_schema_version() == stored_version
+    finally:
+        connection.close()

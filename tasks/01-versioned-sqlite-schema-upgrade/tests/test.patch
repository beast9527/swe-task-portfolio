@@ -0,0 +1,234 @@
+import sqlite3
+
+import pytest
+
+
+def _load_registry():
+    from minecraft_mod_manager.gateways.migration_registry import MigrationRegistry
+
+    return MigrationRegistry
+
+
+def _memory_connection() -> sqlite3.Connection:
+    return sqlite3.connect(":memory:")
+
+
+def _registry_with(*versions) -> "tuple[MigrationRegistry, list]":
+    """Create a registry whose migrations record the applied version in order."""
+    MigrationRegistry = _load_registry()
+    registry = MigrationRegistry()
+    applied: list = []
+    for version in versions:
+
+        def migration(conn, version=version):
+            applied.append(version)
+            conn.execute(f"CREATE TABLE IF NOT EXISTS migrated_{version} (x INTEGER)")
+
+        registry.register(version, migration)
+    return registry, applied
+
+
+def test_migration_registry_versions_sorted_ascending():
+    registry, _ = _registry_with(3, 1, 5, 2)
+
+    assert registry.versions() == [1, 2, 3, 5]
+
+
+def test_migration_registry_versions_empty_list():
+    MigrationRegistry = _load_registry()
+    registry = MigrationRegistry()
+
+    assert registry.versions() == []
+
+
+def test_migration_registry_register_duplicate_raises_exact_message():
+    MigrationRegistry = _load_registry()
+    registry = MigrationRegistry()
+    registry.register(2, lambda conn: None)
+
+    with pytest.raises(ValueError) as excinfo:
+        registry.register(2, lambda conn: None)
+
+    assert str(excinfo.value) == "Migration for version 2 already registered"
+
+
+def test_migration_registry_register_duplicate_error_contains_version_number():
+    MigrationRegistry = _load_registry()
+    registry = MigrationRegistry()
+    registry.register(7, lambda conn: None)
+
+    with pytest.raises(ValueError) as excinfo:
+        registry.register(7, lambda conn: None)
+
+    assert "7" in str(excinfo.value)
+    assert str(excinfo.value) == "Migration for version 7 already registered"
+
+
+def test_migration_registry_migrate_applies_versions_in_ascending_order():
+    conn = _memory_connection()
+    registry, applied = _registry_with(1, 2, 3)
+
+    try:
+        registry.migrate(conn, 0, 3)
+    finally:
+        conn.close()
+
+    assert applied == [1, 2, 3]
+
+
+def test_migration_registry_migrate_skips_versions_at_or_below_from_version():
+    conn = _memory_connection()
+    registry, applied = _registry_with(1, 2, 3, 4)
+
+    try:
+        registry.migrate(conn, 1, 3)
+    finally:
+        conn.close()
+
+    assert applied == [2, 3]
+
+
+def test_migration_registry_migrate_includes_to_version():
+    conn = _memory_connection()
+    registry, applied = _registry_with(1, 2, 3)
+
+    try:
+        registry.migrate(conn, 0, 2)
+    finally:
+        conn.close()
+
+    assert applied == [1, 2]
+    assert 3 not in applied
+
+
+def test_migration_registry_migrate_from_version_greater_than_to_raises():
+    conn = _memory_connection()
+    registry, _ = _registry_with(1, 2, 3)
+
+    try:
+        with pytest.raises(ValueError) as excinfo:
+            registry.migrate(conn, 5, 2)
+    finally:
+        conn.close()
+
+    assert str(excinfo.value) == "from_version must be less than or equal to to_version"
+
+
+def test_migration_registry_migrate_from_gt_to_checked_before_missing_versions():
+    conn = _memory_connection()
+    registry, _ = _registry_with(1)
+
+    try:
+        with pytest.raises(ValueError) as excinfo:
+            registry.migrate(conn, 4, 2)
+    finally:
+        conn.close()
+
+    assert str(excinfo.value) == "from_version must be less than or equal to to_version"
+
+
+def test_migration_registry_migrate_missing_version_raises_exact_message():
+    conn = _memory_connection()
+    registry, _ = _registry_with(1, 2, 4)
+
+    try:
+        with pytest.raises(ValueError) as excinfo:
+            registry.migrate(conn, 0, 4)
+    finally:
+        conn.close()
+
+    assert str(excinfo.value) == "Missing migration for version 3"
+
+
+def test_migration_registry_migrate_missing_first_required_version_raises():
+    conn = _memory_connection()
+    registry, _ = _registry_with(1)
+
+    try:
+        with pytest.raises(ValueError) as excinfo:
+            registry.migrate(conn, 0, 2)
+    finally:
+        conn.close()
+
+    assert str(excinfo.value) == "Missing migration for version 2"
+
+
+def test_migration_registry_migrate_stops_after_migration_exception():
+    conn = _memory_connection()
+    MigrationRegistry = _load_registry()
+    applied: list = []
+    registry = MigrationRegistry()
+
+    def version_one(conn):
+        applied.append(1)
+        conn.execute("CREATE TABLE migrated_1 (x INTEGER)")
+
+    def version_two(conn):
+        applied.append(2)
+        raise RuntimeError("boom in migration 2")
+
+    def version_three(conn):
+        applied.append(3)
+        conn.execute("CREATE TABLE migrated_3 (x INTEGER)")
+
+    registry.register(1, version_one)
+    registry.register(2, version_two)
+    registry.register(3, version_three)
+
+    try:
+        with pytest.raises(RuntimeError):
+            registry.migrate(conn, 0, 3)
+    finally:
+        conn.close()
+
+    assert applied == [1, 2]
+    assert 3 not in applied
+
+
+def test_migration_registry_migrate_propagates_original_exception_message():
+    conn = _memory_connection()
+    MigrationRegistry = _load_registry()
+    registry = MigrationRegistry()
+
+    def failing_migration(conn):
+        raise ValueError("original failure text")
+
+    registry.register(1, failing_migration)
+
+    try:
+        with pytest.raises(ValueError) as excinfo:
+            registry.migrate(conn, 0, 1)
+    finally:
+        conn.close()
+
+    assert str(excinfo.value) == "original failure text"
+
+
+def test_migration_registry_validate_contiguous_true_for_1_2_3():
+    registry, _ = _registry_with(1, 2, 3)
+
+    assert registry.validate_contiguous() is True
+
+
+def test_migration_registry_validate_contiguous_true_for_single_version_one():
+    registry, _ = _registry_with(1)
+
+    assert registry.validate_contiguous() is True
+
+
+def test_migration_registry_validate_contiguous_false_when_version_one_missing():
+    registry, _ = _registry_with(2, 3, 4)
+
+    assert registry.validate_contiguous() is False
+
+
+def test_migration_registry_validate_contiguous_false_for_gap_in_middle():
+    registry, _ = _registry_with(1, 2, 4, 5)
+
+    assert registry.validate_contiguous() is False
+
+
+def test_migration_registry_validate_contiguous_false_when_not_starting_at_one():
+    registry, _ = _registry_with(0, 1, 2)
+
+    assert registry.validate_contiguous() is False

+import re
+import sys
+
+from minecraft_mod_manager.config import config
+from minecraft_mod_manager.core.entities.actions import Actions
+from minecraft_mod_manager.gateways.arg_parser import parse_args
+
+
+class _StubSchemaInfoRepo:
+    """Minimal SchemaInfoRepo test double exposing only the documented repo methods."""
+
+    def __init__(self, version: int, integrity: bool):
+        self._version = version
+        self._integrity = integrity
+
+    def get_schema_version(self) -> int:
+        return self._version
+
+    def verify_integrity(self) -> bool:
+        return self._integrity
+
+
+def test_actions_enum_exposes_schema_info():
+    schema_info = Actions.from_name("schema-info")
+
+    assert schema_info is not None
+    assert schema_info.value == "schema-info"
+
+
+def test_schema_info_parse_args_sets_schema_info_action(monkeypatch):
+    monkeypatch.setattr(sys, "argv", ["mmm", "schema-info"])
+
+    args = parse_args()
+
+    schema_info = Actions.from_name("schema-info")
+    assert schema_info is not None
+    assert args.action == schema_info
+    assert args.action.value == "schema-info"
+
+
+def test_schema_info_execute_prints_ok_lines(capsys):
+    from minecraft_mod_manager.app.schema_info.schema_info import SchemaInfo
+
+    SchemaInfo(_StubSchemaInfoRepo(version=4, integrity=True)).execute()
+
+    assert capsys.readouterr().out == "Schema version: 4\nIntegrity: ok\n"
+
+
+def test_schema_info_execute_prints_corrupt_lines(capsys):
+    from minecraft_mod_manager.app.schema_info.schema_info import SchemaInfo
+
+    SchemaInfo(_StubSchemaInfoRepo(version=9, integrity=False)).execute()
+
+    assert capsys.readouterr().out == "Schema version: 9\nIntegrity: corrupt\n"
+
+
+def test_schema_info_execute_prints_fresh_db_zero_version(capsys):
+    from minecraft_mod_manager.app.schema_info.schema_info import SchemaInfo
+
+    SchemaInfo(_StubSchemaInfoRepo(version=0, integrity=True)).execute()
+
+    assert capsys.readouterr().out == "Schema version: 0\nIntegrity: ok\n"
+
+
+def test_main_schema_info_action_prints_schema_and_integrity(monkeypatch, capsys, tmp_path):
+    saved_dir = config.dir
+    saved_action = getattr(config, "action", None)
+    saved_pretend = config.pretend
+    saved_verbose = config.verbose
+    saved_debug = config.debug
+    saved_arg_mods = config.arg_mods
+    monkeypatch.setattr(config, "dir", tmp_path)
+    monkeypatch.setattr(sys, "argv", ["mmm", "schema-info", "-d", str(tmp_path)])
+    try:
+        import minecraft_mod_manager.__main__ as main_module
+
+        main_module.main()
+    finally:
+        config.dir = saved_dir
+        config.pretend = saved_pretend
+        config.verbose = saved_verbose
+        config.debug = saved_debug
+        config.arg_mods = saved_arg_mods
+        if saved_action is None:
+            if hasattr(config, "action"):
+                del config.action
+        else:
+            config.action = saved_action
+
+    lines = capsys.readouterr().out.splitlines()
+    assert len(lines) == 2
+    assert re.fullmatch(r"Schema version: \d+", lines[0]), lines
+    assert lines[1] == "Integrity: ok", lines
diff --git a/minecraft_mod_manager/gateways/sqlite_upgrader_schema_upgrade_test.py b/minecraft_mod_manager/gateways/sqlite_upgrader_schema_upgrade_test.py
